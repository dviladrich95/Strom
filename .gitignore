# ── Python artifacts ─────────────────────────────────────────────────────────
__pycache__/
*.pyc
/strom.egg-info/

# ── Virtual environment ───────────────────────────────────────────────────────
/.venv/

# ── Notebooks ────────────────────────────────────────────────────────────────
*.ipynb

# ── IDE / editor ─────────────────────────────────────────────────────────────
.idea/
.vscode/
.DS_Store

# ── AI tools ─────────────────────────────────────────────────────────────────
.aider*
CLAUDE.md
/.claude/

# ── Config (keep defaults, ignore local overrides) ───────────────────────────
/config/*
!/config/.gitkeep
!/config/house_config.json

# ── Data ─────────────────────────────────────────────────────────────────────
data/*
!data/Spain.csv
!data/.gitkeep
!data/chunks_Mar23_Mar25/
data/chunks_Mar23_Mar25/*
!data/chunks_Mar23_Mar25/.gitkeep

# ── Outputs ──────────────────────────────────────────────────────────────────
plots/*
!plots/.gitkeep

results/*
!results/.gitkeep

docs/_build/
docs/papers/*.pdf

# ── Observable Framework ──────────────────────────────────────────────────────
docs/observable/.observablehq/
docs/observable/src/.observablehq/
docs/observable/dist/
docs/observable/node_modules/
